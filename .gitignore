# ==========================================
# 1. FRONTEND (Node / React / Build Artifacts)
# ==========================================
node_modules/
dist/
dist-ssr/
.eslintcache

# Block accidental C# IDE solution files inside the frontend folder only
frontend/**/*.sln

# Frontend Environment Secrets
*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==========================================
# 2. BACKEND (.NET / C# Framework)
# ==========================================
bin/
obj/

# User-specific developer overrides
*.user
*.suo
*.userosscache
*.sln.docstates

# Database Secrets File (Do NOT commit local database credentials)
backend/appsettings.Development.json

# Local EF Core SQLite/Cache database artifacts (Safe to ignore)
*.db-shm
*.db-wal

# ==========================================
# 3. IDEs, EDITORS, AND OS PIPELINES
# ==========================================
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.sw?
*.ntvs*
*.njsproj

# ==========================================
# 4. DIAGNOSTIC LOGS
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
